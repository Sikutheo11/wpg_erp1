# Django
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_TIME_ZONE=Africa/Kigali
DJANGO_LOG_LEVEL=DEBUG
DJANGO_LOG_FORMAT=verbose
# Enable these only after every domain/subdomain is HTTPS-only.
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=False
DJANGO_SECURE_HSTS_PRELOAD=False

# PostgreSQL
POSTGRES_DB=wpg_erp
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_CONN_MAX_AGE=0
POSTGRES_SSLMODE=prefer

# Public provider callback base URL
ECOMMERCE_PAYMENT_CALLBACK_BASE_URL=
# Optional local/test database. Production should leave this False.
DJANGO_USE_SQLITE=False
